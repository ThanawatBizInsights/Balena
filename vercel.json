{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/cold-brew-recipes",
      "destination": "/cold-brew-recipes/index.html"
    },
    {
      "source": "/cold-brew-recipes/:path*",
      "destination": "/cold-brew-recipes/index.html"
    },
    {
      "source": "/cost-calculator",
      "destination": "/cost-calculator/index.html"
    },
    {
      "source": "/price-check",
      "destination": "/price-check/index.html"
    },
    {
      "source": "/trial",
      "destination": "/trial/index.html"
    },
    {
      "source": "/trial/:path*",
      "destination": "/trial/index.html"
    }
  ],
  "headers": [
    {
      "source": "/trial/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/trial",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
