{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/cold-brew-recipes",
      "destination": "/cold-brew-recipes/index.html"
    },
    {
      "source": "/cold-brew-recipes/:path*",
      "destination": "/cold-brew-recipes/index.html"
    },
    {
      "source": "/cost-calculator",
      "destination": "/cost-calculator/index.html"
    },
    {
      "source": "/price-check",
      "destination": "/price-check/index.html"
    },
    {
      "source": "/products",
      "destination": "/products/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/shop",
      "destination": "/shop/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/trial",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/trial/order",
      "destination": "/products",
      "permanent": false
    },
    {
      "source": "/trial/products/:slug",
      "destination": "/products?p=:slug",
      "permanent": false
    },
    {
      "source": "/trial/(cart|checkout|complete)",
      "destination": "/products",
      "permanent": false
    },
    {
      "source": "/trial/:path*",
      "destination": "/",
      "permanent": false
    }
  ]
}
